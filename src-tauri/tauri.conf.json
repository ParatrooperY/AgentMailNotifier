{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Mail Notifier",
  "version": "0.1.0",
  "identifier": "io.github.paratroopery.agent-mail-notifier",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent 邮件通知",
        "width": 900,
        "height": 680,
        "minWidth": 680,
        "minHeight": 560,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
      "windows": {
        "nsis": {
          "installMode": "currentUser",
          "displayLanguageSelector": false,
          "installerHooks": "nsis-hooks.nsh",
          "template": "installer-template.nsi",
          "installerIcon": "icons/icon.ico",
          "uninstallerIcon": "icons/icon.ico"
        }
      }
  }
}
